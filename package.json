{
  "name": "calm-scroll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "clean": "node scripts/clean.mjs",
    "build:extension": "wxt build",
    "build:site": "npm run build:extension && vite build --config site/vite.config.ts && npm run package:extension",
    "package:extension": "node scripts/package-extension.mjs",
    "build": "npm run clean && npm run build:site",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.0",
    "archiver": "^7.0.1",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
